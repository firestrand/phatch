#!/usr/bin/env python

"""Launch script from the bin folder."""

import sys
import os

# Add phatch directory to path
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import phatch
from phatch.app import main

if __name__ == '__main__':
    # Use phatch's init_config_paths which sets up development paths
    config_paths = phatch.init_config_paths()
    sys.exit(main(config_paths, app_file=__file__))
